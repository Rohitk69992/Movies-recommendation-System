# CineMatch — TMDB Movie Recommender Configuration
# Copy this file to .env to configure local settings

# TMDB API Key (Optional)
# Get a free key from https://www.themoviedb.org/settings/api
# If omitted or left empty, CineMatch gracefully uses elegant local poster cards.
TMDB_API_KEY=your_tmdb_api_key_here

# App Configuration
APP_ENV=development
APP_PORT=8501
APP_HOST=localhost

# Model Artifact Directory
MODEL_ARTIFACTS_DIR=models
